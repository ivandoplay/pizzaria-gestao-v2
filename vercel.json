{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://qmrcnoigaszditwchsdz.supabase.co; font-src 'self' data:; connect-src 'self' https://qmrcnoigaszditwchsdz.supabase.co wss://qmrcnoigaszditwchsdz.supabase.co; media-src 'self' blob: https://qmrcnoigaszditwchsdz.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ],
  "build": {
    "env": {
      "VITE_SUPABASE_URL": "https://qmrcnoigaszditwchsdz.supabase.co",
      "VITE_SUPABASE_ANON_KEY": "sb_publishable_hMtaHMPhKk17mKGDhClBHA_KXjTGk8D",
      "VITE_TIMEZONE": "America/Fortaleza"
    }
  }
}
