{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "build": {
    "env": {
      "VITE_SUPABASE_URL": "https://qmrcnoigaszditwchsdz.supabase.co",
      "VITE_SUPABASE_ANON_KEY": "sb_publishable_hMtaHMPhKk17mKGDhClBHA_KXjTGk8D",
      "VITE_TIMEZONE": "America/Fortaleza"
    }
  }
}
